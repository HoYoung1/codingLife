// ─────────────────────────────────────────
// 1. 로그 파일 경로 감지
// ─────────────────────────────────────────
local.file_match "app_logs" {
  path_targets = [
    {
      "__path__" = "logs/app.log",
      "job"      = "myapp",
      "env"      = "local",
    },
  ]
  sync_period = "5s"
}

// ─────────────────────────────────────────
// 2. 파일에서 로그 읽기
// ─────────────────────────────────────────
loki.source.file "app_log_scrape" {
  targets       = local.file_match.app_logs.targets
  forward_to    = [loki.process.parse.receiver]
  tail_from_end = false  // 기존 로그도 수집 (학습용)
}

// ─────────────────────────────────────────
// 3. 라벨 파싱 및 추가
// ─────────────────────────────────────────
loki.process "parse" {
  forward_to = [loki.write.local_loki.receiver]

  // dummy_app.py 로그에서 level 값을 라벨로 추출
  // 예: level=INFO  → label level="INFO"
  stage.regex {
    expression = "level=(?P<level>\\w+)"
  }

  stage.labels {
    values = {
      level = "level",
    }
  }
}

// ─────────────────────────────────────────
// 4. Loki로 전송 (localhost)
// ─────────────────────────────────────────
loki.write "local_loki" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}
