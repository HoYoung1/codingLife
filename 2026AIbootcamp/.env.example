# ── 환경 선택 ─────────────────────────────────────────────────
# ollama : 로컬 개발 (Ollama 필요)
# azure  : 운영/서버 (Azure OpenAI 사내망 필요)
LLM_PROVIDER=ollama

# ── Ollama 설정 (LLM_PROVIDER=ollama 일 때 사용) ──────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Azure OpenAI 설정 (LLM_PROVIDER=azure 일 때 사용) ─────────
AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AOAI_API_KEY=<your-api-key>
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
